(cram
 (deps print_endline.gas.txt print_endline.nasm.txt))

(rule
 (deps fac_gas.exe)
 (targets print_endline.gas.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run
     objdump
     -D
     -Mintel-mnemonic
     --disassemble=camlMini__print_endline_40
     %{deps})
    (run head -n 56)
    (run tail -n 20)))))

(rule
 (deps mini_nasm.exe)
 (targets print_endline.nasm.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run
     objdump
     -D
     -Mintel-mnemonic
     --disassemble=camlMini__print_endline_40
     %{deps})
    (run head -n 56)
    (run tail -n 20)))))

(cram
 (deps camlMini__entry.gas.txt camlMini__entry.nasm.txt))

(rule
 (deps fac_gas.exe)
 (targets camlMini__entry.gas.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run objdump -D -Mintel-mnemonic --disassemble=camlMini__entry %{deps})
    (run head -n 64)
    (run tail -n 28)))))

(rule
 (deps mini_nasm.exe)
 (targets camlMini__entry.nasm.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run objdump -D -Mintel-mnemonic --disassemble=camlMini__entry %{deps})
    (run head -n 64)
    (run tail -n 28)))))
