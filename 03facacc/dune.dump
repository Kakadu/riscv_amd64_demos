(cram
 (deps print_endline.gas.txt print_endline.nasm.txt))

(rule
 (deps facacc_gas.exe)
 (targets print_endline.gas.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run
     objdump
     -D
     -Mintel-mnemonic
     --disassemble=camlFacacc__print_endline_43
     %{deps})
    (run head -n-4)
    ;(run tail -n 20)
    ))))

(rule
 (deps fac_nasm.exe)
 (targets print_endline.nasm.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run
     objdump
     -D
     -Mintel-mnemonic
     --disassemble=camlFacacc__print_endline_43
     %{deps})
    (run head -n 29)
    ;(run tail -n 20)
    ))))

