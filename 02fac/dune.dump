(cram
 (deps print_endline.gas.txt print_endline.nasm.txt))

(rule
 (deps fac_gas.o)
 (targets print_endline.gas.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run
     objdump
     -D
     -Mintel-mnemonic
     --disassemble=camlFac__print_endline_40
     %{deps})
    ;(run head -n 56)
    (run tail -n 20)))))

(rule
 (deps fac_nasm.exe)
 (targets print_endline.nasm.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run
     objdump
     -D
     -Mintel-mnemonic
     --disassemble=camlFac__print_endline_40
     %{deps})
    (run head -n 56)
    (run tail -n 20)))))

(cram
 (deps entry.gas.txt entry.nasm.txt))

(rule
 (deps fac_gas.exe)
 (targets entry.gas.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run objdump -D -Mintel-mnemonic --disassemble=camlFac__entry %{deps})
    (run head -n 64)
    (run tail -n 28)))))

(rule
 (deps fac_nasm.exe)
 (targets entry.nasm.txt)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{targets}
   (pipe-stdout
    (run objdump -D -Mintel-mnemonic --disassemble=camlFac__entry %{deps})
    (run head -n 64)
    (run tail -n 28)))))
