; (include dune.dump)

(rule
 (deps fac_gas_startup.s)
 (targets fac_gas_startup.o)
 (mode
  (promote (until-clean)))
 (action
  (run as -o %{targets} %{deps})))

(rule
 (deps fac_gas.s)
 (targets fac_gas.o)
 (mode
  (promote (until-clean)))
 (action
  (run as -o %{targets} %{deps})))

(rule
 (deps fac_gas_startup.o fac_gas.o)
 (targets fac_gas.exe)
 (action
  (run gcc -o %{targets} %{deps} -L%{ocaml_where} -lasmrun -lm)))

(cram
 (applies_to 1)
 (deps fac_gas.exe))

