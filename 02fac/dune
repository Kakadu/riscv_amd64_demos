;;;;;;;;;;;;;;;;;;;;;; RV64

(rule
 (deps fac_rv64_startup.s)
 (targets fac_rv64_startup.o)
 (mode
  (promote (until-clean)))
 (action
  (run riscv64-linux-gnu-as -g -o %{targets} %{deps})))

(rule
 (deps fac_rv64.s)
 (targets fac_rv64.o)
 (mode
  (promote (until-clean)))
 (action
  (run riscv64-linux-gnu-as -g -o %{targets} %{deps})))

(rule
 (deps fac_rv64_startup.o fac_rv64.o)
 (targets fac_rv64.exe)
 (mode
  (promote (until-clean)))
 (action
  (run
   riscv64-linux-gnu-gcc
   -o
   %{targets}
   -L%{read:../risc_ocaml_lib.txt}
   %{deps}
   -lasmrun
   -lm)))

(cram
 (applies_to rv64)
 (deps fac_rv64.exe))
