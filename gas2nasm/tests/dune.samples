(rule
 (deps Tuple1.ml)
 (targets Tuple1.s Tuple1.o Tuple1.exe.startup.s Tuple1.exe)
 (mode
  (promote (until-clean)))
 (action
  (run
   ocamlopt
   -dstartup
   -S
   %{deps}
   -nopervasives
   -verbose
   -o
   Tuple1.exe
   -ccopt
   -lasmrun
   -ccopt
   -lm)))

(rule
 (deps Tuple1.exe.startup.s)
 (targets Tuple1.startup.yasm.s)
 (mode
  (promote (until-clean)))
 (action
  (run ../gas2nasm.exe -startup -main Tuple1 %{deps} -o %{targets})))

(rule
 (deps Tuple1.s)
 (targets Tuple1.yasm.s)
 (mode
  (promote (until-clean)))
 (action
  (run ../gas2nasm.exe -main Tuple1 %{deps} -o %{targets})))


(rule
 (deps Tuple1.startup.yasm.s)
 (targets Tuple1_yasm_startup.o)
 ; (mode
 ;  (promote (until-clean)))
 (action
  (run yasm -g dwarf2 -f elf64 -o %{targets} %{deps})))

(rule
 (deps Tuple1.yasm.s)
 (targets Tuple1.yasm.o)
 (mode
  (promote (until-clean)))
 (action
  (run yasm -g dwarf2 -f elf64 -o %{targets} %{deps})))

(rule
 (deps Tuple1_yasm_startup.o Tuple1.yasm.o)
 (targets Tuple1_yasm.exe)
 (mode
  (promote (until-clean)))
 (action
  (run gcc -o %{targets} %{deps} -L%{ocaml_where} -lasmrun -lm)))

(cram
 (deps Tuple1_yasm.exe))

